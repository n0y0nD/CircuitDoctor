            "3V3",
            "3.3V",
            "+3.3V"
          ],
          "role": "rail",
          "nominal_voltage": 3.3
        },
        {
          "names": [
            "GND"
          ],
          "role": "ground",
          "nominal_voltage": 0.0
        },
        {
          "names": [
            "IOREF"
          ],
          "role": "rail",
          "nominal_voltage": 5.0
        }
      ],
      "sources": [
