				(pintype "power_in+no_connect")
			)
		)
		(net
			(code "31")
			(name "unconnected-(A1-~{RESET}-Pad3)")
			(class "Default")
			(node
				(ref "A1")
				(pin "3")
				(pinfunction "~{RESET}_3")
				(pintype "input+no_connect")
			)
		)
	)
)
